<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_1">

    <!-- ViewPager: Uygulamaları listeler -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="250dp"
        android:layout_marginEnd="100dp"
        app:layout_constraintBottom_toTopOf="@+id/pageIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Sayfa Göstergesi (Dots) - ViewPager'a hizalandı -->
    <LinearLayout
        android:id="@+id/pageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/il_wallpaper_change_trigger"
        app:layout_constraintEnd_toEndOf="@+id/viewPager"
        app:layout_constraintStart_toStartOf="@+id/viewPager">

        <View
            android:id="@+id/indicatorDot1"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_margin="6dp"
            android:alpha="1.0"
            android:background="@drawable/bg_indicator_dot" />

        <View
            android:id="@+id/indicatorDot2"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_margin="6dp"
            android:alpha="0.3"
            android:background="@drawable/bg_indicator_dot" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Duvar Kağıdı Değiştirme Butonu (Merkezin 100dp Solunda) -->
    <ImageView
        android:id="@+id/il_wallpaper_change_trigger"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginBottom="40dp"
        android:layout_marginEnd="100dp"
        android:alpha="1.0"
        android:background="@drawable/bg_wallpaper_button"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_gallery"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_center" />

    <!-- Anasayfa Butonu (Merkezin 100dp Sağında) -->
    <ImageView
        android:id="@+id/btn_go_home"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginBottom="40dp"
        android:layout_marginStart="100dp"
        android:alpha="1.0"
        android:background="@drawable/bg_wallpaper_button"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_gallery"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guideline_center" />

    <!-- Split Screen Butonu (Tam Merkezde) -->
    <ImageView
        android:id="@+id/btn_split_trigger"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginBottom="40dp"
        android:alpha="1.0"
        android:background="@drawable/bg_wallpaper_button"
        android:clickable="true"
        android:focusable="true"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_agenda"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>