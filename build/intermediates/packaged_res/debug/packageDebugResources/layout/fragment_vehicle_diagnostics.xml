<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="250dp"
        android:paddingEnd="100dp"
        android:paddingTop="32dp"
        android:paddingBottom="64dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gelişmiş Araç Diagnostiği"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <!-- Kontrol Anahtarları -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#33000000"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <Switch
                android:id="@+id/swHvac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Klima Verileri "
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginEnd="32dp" />

            <Switch
                android:id="@+id/swDoors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kapı/Kilit Verileri "
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginEnd="32dp" />

            <Switch
                android:id="@+id/swSignals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sinyal/Tuş Verileri "
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- Klima Grubu -->
        <TextView
            android:id="@+id/tvHvacHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KLİMA VE SICAKLIK"
            android:textColor="#29D9F8"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:alpha="0.5"/>
        <include android:id="@+id/rowTempLeft" layout="@layout/item_vehicle_property" />
        <include android:id="@+id/rowTempRight" layout="@layout/item_vehicle_property" />
        <include android:id="@+id/rowFanSpeed" layout="@layout/item_vehicle_property" />
        <include android:id="@+id/rowACMode" layout="@layout/item_vehicle_property" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#33FFFFFF" android:layout_marginVertical="24dp"/>

        <!-- Kapı Grubu -->
        <TextView
            android:id="@+id/tvDoorsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KAPI VE GÜVENLİK"
            android:textColor="#29D9F8"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:alpha="0.5"/>
        <include android:id="@+id/rowDoorFL" layout="@layout/item_vehicle_property" />
        <include android:id="@+id/rowDoorFR" layout="@layout/item_vehicle_property" />
        <include android:id="@+id/rowDoorRL" layout="@layout/item_vehicle_property" />
        <include android:id="@+id/rowDoorRR" layout="@layout/item_vehicle_property" />
        <include android:id="@+id/rowTrunk" layout="@layout/item_vehicle_property" />
        <include android:id="@+id/rowHood" layout="@layout/item_vehicle_property" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#33FFFFFF" android:layout_marginVertical="24dp"/>

        <!-- Sinyal ve Tuş Grubu -->
        <TextView
            android:id="@+id/tvSignalsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SİNYALLER VE DONANIM TUŞLARI"
            android:textColor="#29D9F8"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:alpha="0.5"/>
        <include android:id="@+id/rowTurnSignal" layout="@layout/item_vehicle_property" />
        <include android:id="@+id/rowHighBeam" layout="@layout/item_vehicle_property" />
        <include android:id="@+id/rowHazard" layout="@layout/item_vehicle_property" />
        <include android:id="@+id/rowSteeringButtons" layout="@layout/item_vehicle_property" />

    </LinearLayout>
</ScrollView>
