<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="172dp"
    android:layout_height="match_parent"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- Avatar / Profil Animasyonu - Üste sabitlendi -->
    <ImageView
        android:id="@+id/sidebarAvatar"
        android:layout_width="150dp"
        android:layout_height="160dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/sidebar_avatar_listen_anim"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Orta Buton Grubu - Dikeyde dengeli yayılmış (Vertical Chain) -->
    <ImageButton
        android:id="@+id/sidebarMedia"
        android:layout_width="110dp"
        android:layout_height="105dp"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/icon_media"
        android:scaleType="fitCenter"
        android:src="@mipmap/setup_bt_list_btmusic_icon"
        android:stateListAnimator="@animator/sidebar_icon_state_animator"
        app:layout_constraintBottom_toTopOf="@+id/sidebarPhone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sidebarAvatar"
        app:layout_constraintVertical_chainStyle="spread"
        tools:ignore="ImageContrastCheck" />

    <ImageButton
        android:id="@+id/sidebarPhone"
        android:layout_width="110dp"
        android:layout_height="105dp"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/icon_phone"
        android:scaleType="fitCenter"
        android:src="@drawable/sidebar_phone_menu_selector"
        android:stateListAnimator="@animator/sidebar_icon_state_animator"
        app:layout_constraintBottom_toTopOf="@+id/btnHome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sidebarMedia" />

    <!-- Home Button - En alta sabitlendi -->
    <ImageButton
        android:id="@+id/btnHome"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/abc_action_bar_home_description"
        android:padding="22dp"
        android:scaleType="fitCenter"
        android:src="@drawable/sidebar_home_menu_selector"
        android:stateListAnimator="@animator/sidebar_icon_state_animator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>