<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_1">

    <!-- ViewPager: Uygulamaları listeler -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toTopOf="@+id/pageIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Sayfa Göstergesi (Dots) -->

    <!-- Fragment Container -->
    <LinearLayout
        android:id="@+id/pageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/il_wallpaper_change_trigger"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/indicatorDot1"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_margin="6dp"
            android:alpha="1.0"
            android:background="@drawable/bg_indicator_dot" />

        <View
            android:id="@+id/indicatorDot2"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_margin="6dp"
            android:alpha="0.3"
            android:background="@drawable/bg_indicator_dot" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Duvar Kağıdı Değiştirme Butonu (Sola 25dp kaydırıldı) -->

    <!-- Split-Screen Toggle Button -->
    <ImageView
        android:id="@+id/il_wallpaper_change_trigger"
        android:layout_width="38dp"
        android:layout_height="44dp"
        android:layout_marginBottom="40dp"
        android:alpha="1.0"
        android:background="@drawable/bg_wallpaper_button"
        android:clickable="true"
        android:focusable="true"
        android:importantForAccessibility="no"
        android:padding="16dp"
        android:src="@android:drawable/ic_menu_gallery"
        android:tint="#FFFFFF"
        android:translationX="-25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.349"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/iv_split_screen_toggle"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:alpha="0.8"
        android:background="@drawable/bg_wallpaper_button"
        android:padding="15dp"
        android:src="@android:drawable/ic_menu_more"
        android:tint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>