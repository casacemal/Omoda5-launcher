# Android fstab file.
#<src>                                                  <mnt_point>         <type>    <mnt_flags and options>                       <fs_mgr_flags>
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

/dev/block/by-name/system 	/system 	ext4 	ro 	wait,first_stage_mount,slotselect
/dev/block/by-name/vendor      /vendor      ext4    ro,noatime,nodev     wait,first_stage_mount,slotselect
/dev/block/by-name/userdata    /data        ext4    nosuid,nodev,nodiratime,noatime,nomblk_io_submit,noauto_da_alloc    wait,formattable
/devices/platform/soc/341a0000.sdhci/mmc_host/mmc*                   auto               auto      defaults  voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/soc/soc:usb3@31260000/31260000.dwc3/xhci-hcd.0.auto/* auto auto defaults voldmanaged=usb:auto,encryptable=userdata
/devices/platform/soc/soc:usb3@31120000/31220000.dwc3/xhci-hcd.1.auto/* auto auto defaults voldmanaged=usb:auto,encryptable=userdata
/dev/block/by-name/misc        /misc        emmc    defaults                                                                         defaults
/dev/block/by-name/map    /map        ext4    nosuid,nodev,nodiratime,noatime,nomblk_io_submit,noauto_da_alloc    wait,formattable
/dev/block/by-name/fota    /fota        ext4    nosuid,nodev,nodiratime,noatime,nomblk_io_submit,noauto_da_alloc    wait,formattable
/dev/block/by-name/online    /online        ext4    nosuid,nodev,nodiratime,noatime,nomblk_io_submit,noauto_da_alloc    wait,formattable
/dev/block/by-name/speech    /speech        ext4    nosuid,nodev,nodiratime,noatime,nomblk_io_submit,noauto_da_alloc    wait,formattable
/dev/block/by-name/configure    /configure        ext4    nosuid,nodev,nodiratime,noatime,nomblk_io_submit,noauto_da_alloc    wait,formattable
/dev/block/zram0 none swap defaults zramsize=50%
