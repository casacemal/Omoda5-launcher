<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Launcher Ayarları"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExpandHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#33000000"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:text="Split Uygulama Eşleştirmeleri ▸"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="8dp"
            android:background="#22000000"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Canlı renk: split uyumlu | Soluk: uyumsuz"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />

        <!-- ADB Settings Section -->
        <TextView
            android:id="@+id/adb_settings_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#33000000"
            android:padding="12dp"
            android:text="ADB Bağlantı Ayarları"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <!-- ADB Enable/Disable -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#22000000"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ADB Etkinleştir"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/adb_enabled_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />

        </LinearLayout>

        <!-- ADB Mode Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#22000000"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ADB Modu"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/adb_mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/adb_mode_usb"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="USB"
                    android:textColor="@android:color/white" />

                <RadioButton
                    android:id="@+id/adb_mode_tcp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="TCP/IP"
                    android:textColor="@android:color/white" />

            </RadioGroup>

        </LinearLayout>

        <!-- ADB Port Configuration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#22000000"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Port"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/adb_port_edit"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:background="#33000000"
                android:inputType="number"
                android:padding="8dp"
                android:text="5555"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <!-- ADB Authentication -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#22000000"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kimlik Doğrulama"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/adb_auth_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

        </LinearLayout>

        <!-- ADB Timeout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#22000000"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Zaman Aşımı (sn)"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/adb_timeout_edit"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:background="#33000000"
                android:inputType="number"
                android:padding="8dp"
                android:text="300"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <!-- ADB Status -->
        <TextView
            android:id="@+id/adb_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#22000000"
            android:padding="12dp"
            android:text="ADB Durumu: Devre Dışı"
            android:textColor="#FFFF00"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
